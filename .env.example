# Server port (hosts like Render/Railway inject their own PORT)
PORT=3000

# Bearer token clients must send as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
# NEVER commit a real token to git.
CONNECTOR_API_TOKEN=changeme-generate-a-real-token

# Freemium tier: "free" aggregates only the first FREE_ACCOUNT_LIMIT
# accounts; "paid" aggregates all accounts. Billing is handled through
# the Meta Muse Connector Platform (Stripe).
PLAN=free
FREE_ACCOUNT_LIMIT=2
